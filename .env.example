# Optional override of the public site URL (canonical links, sitemap, Open Graph, JSON-LD).
# Leave empty to use `url` from data/site.json (https://abel-addis.com).
NEXT_PUBLIC_SITE_URL=

# Contact form. Without RESEND_API_KEY the form falls back to "compose + copy + mailto".
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend; onboarding@resend.dev only delivers to the Resend account owner.
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Where messages are delivered.
CONTACT_TO=addis0132@gmail.com
